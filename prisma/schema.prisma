// Shift Swapper — core data model
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Neon / Supabase / any Postgres works
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  // No signup form collects this yet — magic-link sign-in creates users with
  // a blank name (Azure AD used to supply this from the OAuth profile).
  name          String    @default("")
  image         String?
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]

  shifts          Shift[]       @relation("ShiftOwner")
  requestedSwaps  SwapRequest[] @relation("Requester")
  acceptedSwaps   SwapRequest[] @relation("AcceptedBy")
  messages        Message[]
  swapPreferences SwapPreference[]
}

// Required by the NextAuth Prisma adapter. Not used by the Email provider
// itself, but keeps the schema ready if an OAuth provider is added later.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Stores the hashed magic-link token between "email sent" and "link clicked".
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// One shared channel for all dons — no DMs, no per-swap threads.
model Message {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Shift {
  id        String   @id @default(cuid())
  ownerId   String
  owner     User     @relation("ShiftOwner", fields: [ownerId], references: [id])
  date      DateTime // just the calendar date, e.g. 2026-10-14T00:00:00Z
  startTime String   // "19:00"
  endTime   String   // "08:00" (next day, overnight shift)
  createdAt DateTime @default(now())

  // requests where THIS shift is the one being given up
  swapRequestsAsGiven  SwapRequest[] @relation("ShiftGiven")
  // requests where THIS shift is being offered back in a true two-way swap
  swapRequestsAsOffered SwapRequest[] @relation("ShiftOffered")
  // multi-way market preferences where THIS shift is the one being given up
  swapPreferences SwapPreference[] @relation("PreferenceGiveShift")

  @@index([date])
  @@index([ownerId])
}

// The multi-way "Swap Market": people post a shift they want off plus what
// they'd take in return, and the Top Trading Cycles matcher (src/lib/matching.ts)
// finds closed loops of 2+ people who can all get what they want at once, even
// with no direct pair among them.
//
// Lifecycle: open -> matched (grouped into a SwapCycle by the matcher) ->
// back to open if that cycle is denied.
model SwapPreference {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  giveShiftId String
  giveShift   Shift  @relation("PreferenceGiveShift", fields: [giveShiftId], references: [id])

  // Option A: accept only these specific shifts, in preference order (tried first)
  acceptableShiftIds String[] @default([])

  // Option B: fallback filter, used only when none of acceptableShiftIds is
  // currently available — any shift in this date range (+ time-of-day bucket,
  // see timeOfDayBucket() in matching.ts). Null bounds mean "no constraint".
  acceptableFromDate  DateTime?
  acceptableToDate    DateTime?
  acceptableTimeOfDay String?

  status String @default("open") // open | matched | cancelled

  cycleId String?
  cycle   SwapCycle? @relation(fields: [cycleId], references: [id])

  // Once matched: the preference whose giveShift this person will receive.
  // The inverse (who THIS person gives to) is just whichever other preference
  // in the same cycle has matchedWithId pointing back at this one.
  matchedWithId String?         @unique
  matchedWith   SwapPreference? @relation("PreferenceMatch", fields: [matchedWithId], references: [id])
  matchedFrom   SwapPreference? @relation("PreferenceMatch")

  agreedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([status])
}

// A proposed N-way trade: one SwapCycle groups the 2+ SwapPreferences the
// matcher found forming a closed loop.
//
// Lifecycle mirrors SwapRequest, generalized from 2 people to N:
//   proposed          -> matcher just found this cycle, nobody's confirmed yet
//   all_agreed        -> every participant has confirmed their leg
//   pending_approval  -> (same as all_agreed in practice — kept for UI copy)
//   approved          -> RLC approved; every shift in the cycle reassigns at once
//   denied            -> RLC said no (or someone backed out); everyone's
//                        preference returns to "open" for the next matching run
model SwapCycle {
  id        String   @id @default(cuid())
  status    String   @default("proposed")
  createdAt DateTime @default(now())

  preferences SwapPreference[]
}

// Lifecycle:
//   open              -> requester posted it, waiting for someone to agree
//   mutual            -> both people have agreed; email sent to both re: asking the RLC
//   pending_approval  -> (same as mutual in practice — kept for clarity in UI copy)
//   approved          -> RLC approved; shifts have been reassigned, this is final
//   denied            -> RLC said no; nothing changes, requester can re-post
model SwapRequest {
  id        String   @id @default(cuid())

  shiftId   String
  shift     Shift    @relation("ShiftGiven", fields: [shiftId], references: [id])

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])

  // set only if the requester aimed this at one specific person
  targetId  String?

  // set once someone agrees to take the shift (mutual agreement step)
  acceptedById String?
  acceptedBy   User?   @relation("AcceptedBy", fields: [acceptedById], references: [id])

  // optional: if this is a true swap-for-swap rather than a one-way cover,
  // this is the shift the acceptor gives back to the requester
  offeredShiftId String?
  offeredShift   Shift?  @relation("ShiftOffered", fields: [offeredShiftId], references: [id])

  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
